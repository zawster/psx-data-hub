ENV=local
DEBUG=false
APP_NAME=psx-data-hub
API_PREFIX=/v1

DATABASE_URL=sqlite+aiosqlite:///./data/psx-data-hub-smoke.db

DELAY_MINUTES=5
MARKET_WATCHLIST=PSO,OGDC,HBL

POLL_INTERVAL_SECONDS=30
POLL_SYMBOLS_PER_TICK=10
STALE_THRESHOLD_SECONDS=300
REQUEST_TIMEOUT_SECONDS=12

API_KEY_REQUIRED=false
API_KEYS=
RATE_LIMIT_PER_MINUTE=6000
RATE_LIMIT_BURST=1000
AUTH_MODE=off
LEGACY_USERS=demo:demo:public
JWT_SECRET_KEY=smoke-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

PROVIDER_BASE_URL=https://dps.psx.com.pk
PROVIDER_QUOTE_URL_TEMPLATE={provider_base_url}/company/{symbol}
PROVIDER_MARKET_SUMMARY_URL={provider_base_url}/market-summary
PROVIDER_TIMESERIES_URL_TEMPLATE={provider_base_url}/company/{symbol}/timeseries/{interval}

DATA_SOURCE_NOTICE=Data is delayed by at least 5 minutes.
