# General app config
ENV=local
DEBUG=false
APP_NAME=psx-data-hub
API_PREFIX=/v1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/psx-data-hub.db

# Data policy
DELAY_MINUTES=5
MARKET_WATCHLIST=PSO,OGDC,HBL,LUCKY,ENGRO

# Polling
POLL_INTERVAL_SECONDS=30
POLL_SYMBOLS_PER_TICK=6
STALE_THRESHOLD_SECONDS=300
REQUEST_TIMEOUT_SECONDS=12

# Optional public API access control
API_KEY_REQUIRED=false
API_KEYS=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
AUTH_MODE=off
LEGACY_USERS=demo:demo:public
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Source endpoint templates (configurable if PSX changes endpoints)
PROVIDER_BASE_URL=https://dps.psx.com.pk
PROVIDER_QUOTE_URL_TEMPLATE={provider_base_url}/company/{symbol}
PROVIDER_MARKET_SUMMARY_URL={provider_base_url}/market-watch
PROVIDER_INDICES_URL={provider_base_url}/indices
PROVIDER_MARKET_STATUS_URL={provider_base_url}/
PROVIDER_TIMESERIES_URL_TEMPLATE={provider_base_url}/timeseries/{interval}/{symbol}

# If you move/rename endpoints, update this disclaimer language
DATA_SOURCE_NOTICE=Data is delayed. Source is publicly available PSX page feeds.
